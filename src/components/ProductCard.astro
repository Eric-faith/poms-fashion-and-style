---
import { naira, isSoldOut, isOnSale, percentOff, type Product } from '../lib/shop';
interface Props { product: Product; eager?: boolean; compact?: boolean }
const { product, eager = false, compact = false } = Astro.props;
const { title, price, compare_at_price, images, badge, category } = product.data;
const soldOut = isSoldOut(product);
const onSale = isOnSale(product);
const label = soldOut ? 'Sold out' : onSale ? `−${percentOff(product)}%` : badge;
---
<a href={`/products/${product.id}/`} class="group block" data-card data-price={price} data-date={product.data.date?.getTime() ?? 0} data-category={category}>
  <div class="relative aspect-[4/5] overflow-hidden rounded-md bg-mist">
    <img src={images[0]} alt={title} width="1200" height="1500" loading={eager ? 'eager' : 'lazy'} decoding="async"
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" />
    {images[1] && (
      <img src={images[1]} alt="" width="1200" height="1500" loading="lazy" decoding="async"
        class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-300 group-hover:opacity-100" />
    )}
    {label && (
      <span class:list={[
        'absolute left-2.5 top-2.5 rounded-sm px-2 py-1 text-[11px] font-medium uppercase tracking-wider',
        soldOut ? 'bg-white text-stone' : onSale ? 'bg-plum text-white' : 'bg-white text-ink',
      ]}>{label}</span>
    )}
    {!soldOut && !compact && (
      <span class="absolute inset-x-2.5 bottom-2.5 hidden translate-y-2 rounded-md bg-white/95 py-2.5 text-center text-[13px] font-medium opacity-0 transition duration-200 group-hover:translate-y-0 group-hover:opacity-100 md:block">
        View sizes
      </span>
    )}
  </div>
  <div class="mt-3 text-[14px] leading-snug">
    <h3 class="line-clamp-1">{title}</h3>
    <p class="mt-1 tabular-nums">
      <span class:list={[onSale && 'text-plum']}>{naira(price)}</span>
      {onSale && <s class="ml-1.5 text-stone">{naira(compare_at_price!)}</s>}
    </p>
  </div>
</a>
