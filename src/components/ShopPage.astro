---
import Base from '../layouts/Base.astro';
import ProductGrid from './ProductGrid.astro';
import Icon from './Icon.astro';
import { getCategories, type Product } from '../lib/shop';
interface Props { heading: string; products: Product[]; active?: string; intro?: string }
const { heading, products, active, intro } = Astro.props;
const categories = await getCategories();
const chip = 'shrink-0 rounded-full border px-4 py-2 text-[14px] transition-colors';
const on = 'border-ink bg-ink text-white';
const off = 'border-line hover:border-ink';
---
<Base title={heading}>
  <div class="mx-auto max-w-[1440px] px-4 pt-10 md:px-8 md:pt-14">
    <div class="text-center">
      <h1 class="display text-5xl md:text-7xl">{heading}</h1>
      {intro && <p class="mx-auto mt-4 max-w-[48ch] text-stone">{intro}</p>}
    </div>
    <div class="sticky top-[72px] z-20 -mx-4 mt-8 mb-8 flex flex-col gap-3 border-b border-line bg-white/95 px-4 py-3 backdrop-blur md:static md:mx-0 md:flex-row md:items-center md:justify-between md:bg-transparent md:px-0 md:pb-5 md:pt-0">
      <nav aria-label="Categories" class="no-scrollbar -mx-4 flex gap-2 overflow-x-auto px-4 md:mx-0 md:px-0">
        <a href="/shop/" aria-current={!active ? 'page' : undefined} class:list={[chip, !active ? on : off]}>All</a>
        {categories.map((c) => (
          <a href={`/shop/${c.slug}/`} aria-current={active === c.slug ? 'page' : undefined} class:list={[chip, active === c.slug ? on : off]}>{c.name}</a>
        ))}
        <a href="/shop/sale/" aria-current={active === 'sale' ? 'page' : undefined} class:list={[chip, active === 'sale' ? 'border-plum bg-plum text-white' : 'border-line text-plum hover:border-plum']}>Sale</a>
      </nav>
      <div class="flex items-center justify-between gap-4 text-[14px] md:justify-end">
        <p class="text-stone tabular-nums">{products.length} {products.length === 1 ? 'piece' : 'pieces'}</p>
        <label class="relative flex items-center gap-2">
          <span class="text-stone">Sort</span>
          <select data-sort class="appearance-none rounded-md border border-line bg-white py-2 pl-3 pr-8 text-ink">
            <option value="new">Newest</option>
            <option value="low">Price, low to high</option>
            <option value="high">Price, high to low</option>
          </select>
          <Icon name="chevron-down" class="pointer-events-none absolute right-2 h-4 w-4" />
        </label>
      </div>
    </div>
    <ProductGrid products={products} />
  </div>
</Base>

<script>
  const select = document.querySelector<HTMLSelectElement>('[data-sort]');
  const grid = document.querySelector<HTMLElement>('[data-grid]');
  if (select && grid) {
    select.addEventListener('change', () => {
      const items = [...grid.children] as HTMLElement[];
      const val = (li: HTMLElement, k: string) => Number(li.querySelector<HTMLElement>('[data-card]')?.dataset[k] ?? 0);
      items.sort((a, b) =>
        select.value === 'low' ? val(a, 'price') - val(b, 'price')
        : select.value === 'high' ? val(b, 'price') - val(a, 'price')
        : val(b, 'date') - val(a, 'date'));
      grid.append(...items);
    });
  }
</script>
