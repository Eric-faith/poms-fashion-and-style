---
import Base from '../layouts/Base.astro';
---
<Base title="Your bag">
  <div class="mx-auto max-w-[1100px] px-5 pt-10 md:px-10 md:pt-14">
    <h1 class="display text-5xl md:text-6xl">Your bag</h1>
    <div id="bag" class="mt-10">
      <p class="text-stone">Loading your bag…</p>
    </div>
  </div>
</Base>

<script>
  import { resolved, setQty, naira, esc, deliveryFor } from '../scripts/cart';
  const root = document.getElementById('bag')!;

  async function render() {
    const lines = await resolved();
    if (!lines.length) {
      root.innerHTML = `
        <div class="border-t border-line py-16 text-center">
          <p class="text-2xl">Your bag is empty</p>
          <p class="mt-3 text-stone">Pieces you add will show up here.</p>
          <a href="/shop/" class="btn mt-8">Start shopping</a>
        </div>`;
      return;
    }
    const subtotal = lines.reduce((s, l) => s + l.product.price * l.qty, 0);
    const delivery = deliveryFor(subtotal);
    root.innerHTML = `
      <div class="grid gap-12 md:grid-cols-[1fr_320px]">
        <ul class="border-t border-line">
          ${lines.map((l) => {
            const soldOut = l.product.sizes.length > 0 && !l.product.sizes.find((s) => s.size === l.size)?.in_stock;
            return `
            <li class="flex gap-4 border-b border-line py-5">
              <a href="/products/${esc(l.slug)}/" class="w-24 shrink-0 overflow-hidden rounded-md bg-mist md:w-28">
                <img src="${esc(l.product.image)}" alt="" class="aspect-[4/5] w-full object-cover" />
              </a>
              <div class="flex flex-1 flex-col">
                <div class="flex justify-between gap-4">
                  <a href="/products/${esc(l.slug)}/" class="hover:underline hover:underline-offset-4">${esc(l.product.title)}</a>
                  <p class="tabular-nums">${naira(l.product.price * l.qty)}</p>
                </div>
                ${l.size ? `<p class="mt-1 text-sm text-stone">Size ${esc(l.size)}</p>` : ''}
                ${soldOut ? `<p class="mt-1 text-sm text-red-700">This size just sold out. Remove it to check out.</p>` : ''}
                <div class="mt-auto flex items-center justify-between pt-4">
                  <div class="flex items-center border border-line" role="group" aria-label="Quantity for ${esc(l.product.title)}">
                    <button class="h-9 w-9 hover:bg-mist" data-qty="${l.qty - 1}" data-slug="${esc(l.slug)}" data-size="${esc(l.size)}" aria-label="Decrease quantity">−</button>
                    <span class="w-8 text-center text-sm tabular-nums">${l.qty}</span>
                    <button class="h-9 w-9 hover:bg-mist disabled:opacity-40" data-qty="${l.qty + 1}" data-slug="${esc(l.slug)}" data-size="${esc(l.size)}" aria-label="Increase quantity" ${l.qty >= 10 ? 'disabled' : ''}>+</button>
                  </div>
                  <button class="text-sm text-stone underline underline-offset-4 hover:text-black" data-qty="0" data-slug="${esc(l.slug)}" data-size="${esc(l.size)}">Remove</button>
                </div>
              </div>
            </li>`;
          }).join('')}
        </ul>
        <aside class="h-fit rounded-md bg-mist p-6">
          <dl class="space-y-3 text-sm">
            <div class="flex justify-between"><dt>Subtotal</dt><dd class="tabular-nums">${naira(subtotal)}</dd></div>
            <div class="flex justify-between"><dt>Delivery</dt><dd class="tabular-nums">${delivery ? naira(delivery) : 'Free'}</dd></div>
            <div class="flex justify-between border-t border-black/15 pt-3 text-base font-semibold"><dt>Total</dt><dd class="tabular-nums">${naira(subtotal + delivery)}</dd></div>
          </dl>
          <a href="/checkout/" class="btn mt-6 w-full">Check out</a>
          <a href="/shop/" class="mt-4 block text-center text-sm underline underline-offset-4">Continue shopping</a>
        </aside>
      </div>`;
  }

  root.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-qty]');
    if (!btn) return;
    setQty(btn.dataset.slug!, btn.dataset.size!, Number(btn.dataset.qty));
  });
  window.addEventListener('bag:change', render);
  render();
</script>
