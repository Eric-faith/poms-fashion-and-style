---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <div class="mx-auto max-w-[640px] px-5 pt-24 text-center">
    <p class="display text-4xl md:text-5xl">This page isn’t here</p>
    <p class="mt-4 text-stone">The item may have sold out or been removed from the shop.</p>
    <a href="/shop/" class="btn mt-8">Shop all</a>
  </div>
</Base>
